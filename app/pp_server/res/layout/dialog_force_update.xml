<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- 3D Rocket Badge -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_avatar_circle">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🚀"
            android:textSize="32sp" />
    </FrameLayout>

    <!-- Title & Version Info -->
    <TextView
        android:id="@+id/txtUpdateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="New Update Required!"
        android:textColor="#0f172a"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtUpdateSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="A new critical update is now available for PP Server."
        android:textColor="#0284c7"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Release Notes Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_light_input"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What's New in this Release:"
            android:textColor="#475569"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUpdateNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Security hardening, real PP Mod profile synchronization, and anti-interception enhancements."
            android:textColor="#0f172a"
            android:textSize="12.5sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Download APK Action Button -->
    <Button
        android:id="@+id/btnDownloadUpdate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_primary_purple"
        android:text="📥 Download and Install Update"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🔒 Security Enforcement: Updating is mandatory to continue."
        android:textColor="#94a3b8"
        android:textSize="10.5sp" />
</LinearLayout>
