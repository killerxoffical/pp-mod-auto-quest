<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_light_card"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <!-- Top Row: Flag, Country, Email, Balance, Delete Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgItemFlag"
            android:layout_width="20dp"
            android:layout_height="14dp"
            android:src="@drawable/flag_global"
            android:scaleType="fitCenter"
            android:contentDescription="Country" />

        <TextView
            android:id="@+id/txtItemCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GLOBAL"
            android:textColor="#0284c7"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_flag_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:layout_marginStart="5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtItemEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@gmail.com"
                android:textColor="#0f172a"
                android:textSize="13sp"
                android:textStyle="bold"
                android:ellipsize="middle"
                android:singleLine="true" />

            <!-- Real Balance Beside/Under Email (Real USD/Currency + Play Points) -->
            <TextView
                android:id="@+id/txtItemBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00 • 0 PTS"
                android:textColor="#059669"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Delete Account Button -->
        <ImageButton
            android:id="@+id/btnItemDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/bg_flag_badge"
            android:contentDescription="Delete"
            android:padding="5dp" />
    </LinearLayout>

    <!-- Revocation / De-auth Warning Alert (Shown if server de-authorized) -->
    <LinearLayout
        android:id="@+id/layoutItemWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_warning_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Server Sync Alert • Tap for details"
            android:textColor="#b45309"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action ❯"
            android:textColor="#b45309"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6-Digit Sync Code Section with Compact Copy Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_flag_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6-DIGIT SYNC CODE"
                android:textColor="#64748b"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtItemCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="------"
                android:textColor="#0284c7"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Compact / Smaller Copy Button -->
        <Button
            android:id="@+id/btnItemCopy"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Copy"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_blue"
            android:drawableStart="@drawable/ic_copy"
            android:drawablePadding="4dp"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Friday Weekly Perk Claim Section (Dynamically Revealed on Friday in BD Time) -->
    <LinearLayout
        android:id="@+id/layoutFridayClaim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnFridayClaim"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="🎁 Claim Weekly Points"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_perk_claim" />
    </LinearLayout>

</LinearLayout>
