<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="22dp">

    <!-- Header Row: Warning Icon, Title, Close Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Logout Warning Badge Icon -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_flag_badge">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🚪"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout Session"
                android:textColor="#ffffff"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnect Active Server Node"
                android:textColor="#ef4444"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Close Icon Button -->
        <ImageButton
            android:id="@+id/btnLogoutDialogClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_flag_badge"
            android:src="@drawable/ic_close"
            android:padding="7dp"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Message Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_token_box"
        android:padding="16dp"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are you sure you want to log out of your PPM Server account?"
            android:textColor="#e2e8f0"
            android:textSize="13.5sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Your local sync sessions will be cleared and this device will enter disconnected standby mode until you log in again."
            android:textColor="#94a3b8"
            android:textSize="11.5sp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Buttons Row: Cancel and Disconnect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnCancelLogout"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#cbd5e1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_secondary_dark"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmLogout"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🚪 Logout"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_red"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
