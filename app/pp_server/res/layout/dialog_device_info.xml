<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="22dp">

    <!-- Header Row: Icon, Title, Close Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Icon Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_success">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📱"
                android:textSize="22sp" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Hardware Node"
                android:textColor="#0f172a"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PPM Server Node Authentication"
                android:textColor="#0284c7"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top-Right Close Button -->
        <ImageButton
            android:id="@+id/btnDialogTopCloseDevice"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_flag_badge"
            android:contentDescription="Close"
            android:padding="7dp" />
    </LinearLayout>

    <!-- Device ID Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_light_input"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HARDWARE DEVICE ID"
            android:textColor="#64748b"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDialogDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_token_box"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="UNKNOWN_DEVICE"
            android:textColor="#0f172a"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textIsSelectable="true" />

        <!-- Copy Device ID Button -->
        <Button
            android:id="@+id/btnDialogCopyDeviceId"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_primary_purple"
            android:text="📋 Copy Device ID"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Node Info Specs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_flag_badge"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Node Status:"
                android:textColor="#64748b"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Active &amp; Connected"
                android:textColor="#10b981"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App Version:"
                android:textColor="#64748b"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/txtDialogNodeVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v3.8 Enterprise (Code 4)"
                android:textColor="#0f172a"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Close Button -->
    <Button
        android:id="@+id/btnDialogCloseDevice"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_secondary_outline"
        android:text="✕ Close"
        android:textColor="#64748b"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
