<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="➕ Connect Google Account"
        android:textColor="#0f172a"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Permanent Master Token will be automatically generated with auto-detected country region."
        android:textColor="#64748b"
        android:textSize="12sp" />

    <!-- Google One-Tap SSO -->
    <LinearLayout
        android:id="@+id/btnConnectGoogleSso"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/btn_google_signin"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_google_logo"
            android:contentDescription="Google" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Instant Google Sign-In"
            android:textColor="#1e293b"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Embedded Web Setup Option -->
    <Button
        android:id="@+id/btnConnectWebSetup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="🌐 Browser / Web Embedded Setup"
        android:textColor="#ffffff"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/btn_primary_purple"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnConnectCancel"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="Cancel"
        android:textColor="#64748b"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_flag_badge"
        android:layout_marginTop="10dp" />

</LinearLayout>
