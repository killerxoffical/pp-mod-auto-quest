<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowCountryItem"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_light_card"
    android:paddingHorizontal="14dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/dialogCountryFlag"
        android:layout_width="22dp"
        android:layout_height="15dp"
        android:src="@drawable/flag_global"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/dialogCountryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="United States"
        android:textColor="#0f172a"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogCountryCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="US"
        android:textColor="#0284c7"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:background="@drawable/bg_flag_badge"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/dialogCountryCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        android:contentDescription="Selected" />
</LinearLayout>
