<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Status Icon Frame -->
    <FrameLayout
        android:id="@+id/authResultIconBox"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_badge_success">

        <TextView
            android:id="@+id/authResultIconEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✅"
            android:textSize="28sp" />
    </FrameLayout>

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/authResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Login Successful"
        android:textColor="#0f172a"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/authResultSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="PPM Server Node Authentication"
        android:textColor="#64748b"
        android:textSize="12sp" />

    <!-- Message Content Box -->
    <LinearLayout
        android:id="@+id/authResultMessageBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_light_input"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/authResultMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Authentication succeeded."
            android:textColor="#1e293b"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Primary Action Button (Enter Dashboard or Open Web Portal) -->
        <Button
            android:id="@+id/btnAuthPrimary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_primary_purple"
            android:text="🚀 Enter Dashboard"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Secondary Button (Close / Dismiss) -->
        <Button
            android:id="@+id/btnAuthSecondary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_secondary_outline"
            android:text="✕ Close"
            android:textColor="#64748b"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
