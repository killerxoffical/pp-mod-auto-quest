<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080b14">

    <!-- ==================== SCREEN 1: MAIN DASHBOARD ==================== -->
    <RelativeLayout
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Dashboard Top Navigation Bar -->
        <LinearLayout
            android:id="@+id/topBarDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_header"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/imgNavLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="PP Server Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PP SERVER"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play Point Quest Cloud Bridge"
                    android:textColor="#38bdf8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Dashboard Refresh Button -->
            <ImageButton
                android:id="@+id/btnRefreshDashboard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_refresh"
                android:background="@drawable/btn_icon_dark"
                android:contentDescription="Refresh"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Bottom Action Button: Add Google Account -->
        <LinearLayout
            android:id="@+id/bottomActionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="#0c101e"
            android:padding="16dp">

            <Button
                android:id="@+id/btnAddAccount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Add Google Account"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary_purple"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="10dp"
                android:paddingHorizontal="20dp" />

            <Button
                android:id="@+id/btnPpModPortal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="🌐 PP Mod Web Portal &amp; Login ➔"
                android:textColor="#38bdf8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_icon_dark"
                android:drawableStart="@drawable/ic_external"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- Dashboard Content ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topBarDashboard"
            android:layout_above="@id/bottomActionPanel"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hero Status Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_hero"
                    android:padding="16dp"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cloud"
                            android:contentDescription="Cloud" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Cloudflare D1 Network"
                            android:textColor="#06b6d4"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE"
                            android:textColor="#ffffff"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/badge_pill_green"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Account Sync Manager"
                        android:textColor="#ffffff"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Google Play Games accounts synced securely. Codes can be used directly on the website or bot."
                        android:textColor="#94a3b8"
                        android:textSize="12sp" />

                    <!-- Quick Stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:paddingTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Accounts: "
                            android:textColor="#64748b"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtAccountCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#10b981"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CONNECTED ACCOUNTS"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instant Sync"
                        android:textColor="#38bdf8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Empty State Card (Visible when 0 accounts) -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_account"
                    android:padding="26dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:src="@drawable/ic_account"
                        android:contentDescription="Empty"
                        android:alpha="0.4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="No Accounts Linked Yet"
                        android:textColor="#cbd5e1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tap 'Add Google Account' below to sign in and generate your 6-digit sync code."
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Dynamic Accounts Container -->
                <LinearLayout
                    android:id="@+id/accountsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </RelativeLayout>


    <!-- ==================== SCREEN 2: GOOGLE SIGN-IN WEBVIEW ==================== -->
    <RelativeLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Login Top Navigation Bar -->
        <LinearLayout
            android:id="@+id/topBarLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_header"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <!-- Back to Dashboard -->
            <ImageButton
                android:id="@+id/btnNavBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/btn_icon_dark"
                android:contentDescription="Back"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Sign In"
                    android:textColor="#ffffff"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtLoginStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connecting securely..."
                    android:textColor="#34d399"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Reload Button -->
            <ImageButton
                android:id="@+id/btnNavReload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_refresh"
                android:background="@drawable/btn_icon_dark"
                android:contentDescription="Reload"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/webProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_below="@id/topBarLogin"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <!-- Clean Step Guide Banner -->
        <LinearLayout
            android:id="@+id/instructionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/webProgressBar"
            android:background="#0c1122"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_code"
                android:contentDescription="Info" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sign in to your Google Account. Your code will generate automatically."
                android:textColor="#94a3b8"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Subtle Helper Bar (Fallback only if user needs to manually trigger verification) -->
        <LinearLayout
            android:id="@+id/loginHelperBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:padding="12dp">

            <Button
                android:id="@+id/btnVerifyManual"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Complete Sign In &amp; Generate Code"
                android:background="@drawable/btn_primary_blue"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/instructionBanner"
            android:layout_above="@id/loginHelperBar" />
    </RelativeLayout>


    <!-- ==================== CODE SUCCESS POPUP SHEET ==================== -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/bg_card_result"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check"
                android:contentDescription="Success" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Connected Successfully"
                    android:textColor="#10b981"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSuccessEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email..."
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Code Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_code_badge"
            android:padding="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR 6-DIGIT SYNC CODE"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSuccessCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="------"
                android:textColor="#ffffff"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Use this code on the Play Point Quest bot or website to sync."
                android:textColor="#64748b"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyCode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Copy Code"
                android:background="@drawable/btn_primary_blue"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_copy"
                android:drawablePadding="6dp"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnReturnDashboard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="View in Dashboard"
                android:background="@drawable/btn_primary_emerald"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="6dp"
                android:paddingHorizontal="16dp" />
        </LinearLayout>
    </LinearLayout>


    <!-- ==================== PREMIUM SPLASH SCREEN OVERLAY ==================== -->
    <RelativeLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="PP Server Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PP SERVER"
                android:textColor="#ffffff"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="PLAY POINT QUEST CLOUD BRIDGE"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Connecting to Cloud Engine..."
                android:textColor="#64748b"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
