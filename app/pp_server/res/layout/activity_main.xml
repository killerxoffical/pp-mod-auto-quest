<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#f8fafc">

    <!-- 1. The Main Hybrid WebApp UI (Always fills full screen) -->
    <WebView
        android:id="@+id/mainAppWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Google Login Overlay Container (Shown ONLY during Google auth) -->
    <RelativeLayout
        android:id="@+id/googleLoginContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff"
        android:visibility="gone">

        <!-- Top Bar for Google Sign-In -->
        <RelativeLayout
            android:id="@+id/googleTopBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0f172a"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <ImageButton
                android:id="@+id/btnNavBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />

            <TextView
                android:id="@+id/txtLoginHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/btnNavBack"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dp"
                android:text="Google Account Verification"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnNavReload"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Reload" />
        </RelativeLayout>

        <!-- Horizontal Progress Bar -->
        <ProgressBar
            android:id="@+id/webProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_below="@id/googleTopBar"
            android:indeterminate="false"
            android:max="100" />

        <!-- Status subtitle under top bar -->
        <TextView
            android:id="@+id/txtLoginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/webProgressBar"
            android:background="#1e293b"
            android:padding="8dp"
            android:textColor="#38bdf8"
            android:textSize="12sp"
            android:gravity="center"
            android:text="Waiting for Google authentication..." />

        <!-- Google Auth WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/txtLoginStatus" />
    </RelativeLayout>
</FrameLayout>
