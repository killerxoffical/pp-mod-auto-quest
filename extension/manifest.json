{
  "manifest_version": 3,
  "name": "PlayQuest Token Extractor",
  "version": "1.0",
  "description": "1-Click Google Play Games Master Token & oauth_token Extractor",
  "permissions": [
    "cookies",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PlayQuest Token Extractor"
  }
}
